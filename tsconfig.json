{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "module": "CommonJS",
    "target": "ES2020",
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "node",
    "typeRoots": [
      "./typings"
    ]
  },
  "include": [
    "miniprogram/**/*.ts",
    "typings/**/*.d.ts"
  ]
}
